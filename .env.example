# devnet (default) or mainnet. Test on devnet first.
NETWORK=devnet

# Your wallet key (WIF). Only write scripts need it. Never commit your .env.
PHANTASMA_WIF=

# Optional: your own RPC node for the chosen network.
# SATURN_RPC_URL=

# Optional: override the gas ceiling (units at gas price 100000).
# GAS_LIMIT=2000000
